{
  "name": "init-project-for-vscode-java-environment",
  "version": "1.0.0",
  "type": "module",
  "private": "true",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "prettier --write \"./**/*.{html,css,js,json}\"",
    "add-javac-parameters-option": "add-javac-parameters-option",
    "add-missing-serial-version-warning-option": "add-missing-serial-version-warning-option",
    "copy-mockito-agent-gradle": "copy-mockito-agent-gradle",
    "copy-mockito-jar": "run-gradle-wrapper copyMockitoJar",
    "init-test-jvm-options": "init-test-jvm-options",
